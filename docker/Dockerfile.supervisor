# syntax=docker/dockerfile:1
# Dev supervisor image — lis db + baked lidb_embed (WP-H).
# Build from lis repo root; requires sibling lidb via BuildKit additional_context (see docker-compose.ph-db.yml).
# NOT production hosting — embed-only registry-min profile, no TCP wire.
FROM debian:bookworm-slim AS lidb-build

RUN apt-get update \
  && apt-get install -y --no-install-recommends cmake g++ make \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src/lidb
COPY --from=lidb . .
RUN rm -rf build

RUN cmake -S . -B build/smoke -DCMAKE_BUILD_TYPE=Release \
  && cmake --build build/smoke --target lidb_embed -j"$(nproc)"

FROM python:3.12-slim-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends libstdc++6 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -e .

COPY --from=lidb-build /src/lidb /opt/lidb

ENV LIDB_REPO=/opt/lidb \
    LIDB_EMBED=/opt/lidb/build/smoke/lidb_embed \
    LI_DATA_DIR=/data \
    LI_PROFILE=registry-min \
    PYTHONUNBUFFERED=1

COPY docker/entrypoint-supervisor.sh /usr/local/bin/entrypoint-supervisor.sh
RUN chmod +x /usr/local/bin/entrypoint-supervisor.sh

VOLUME /data

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD lis db status >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-supervisor.sh"]
