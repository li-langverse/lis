# Copy to deploy/staging/.env and fill before `lis staging up`.

# --- Public hostnames (must match DNS → this VM) ---
MAJICO_STAGING_APP_HOST=staging.majico.example
MAJICO_STAGING_API_HOST=api.staging.majico.example
MAJICO_STAGING_PULSE_HOST=pulse.staging.majico.example

# --- Container images (build/push from cap-jmk-launchpad/majico.xyz) ---
MAJICO_WEB_IMAGE=ghcr.io/cap-jmk-launchpad/majico-web:staging
PULSE_WEB_IMAGE=ghcr.io/cap-jmk-launchpad/pulse-web:staging

# --- Supabase-shaped URLs for Next.js (internal Docker DNS) ---
NEXT_PUBLIC_SUPABASE_URL=https://${MAJICO_STAGING_API_HOST}
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-init
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Postgres (self-hosted) ---
POSTGRES_PASSWORD=generate-a-long-secret

# --- Edge ports (IONOS: forward 80/443 to these) ---
STAGING_HTTP_PORT=80
STAGING_HTTPS_PORT=443

# --- ACME (Caddy automatic HTTPS) ---
ACME_AGREE=true
ACME_EMAIL=ops@example.com
