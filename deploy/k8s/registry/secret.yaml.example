# Copy to secret.yaml locally (never commit real values):
#   cp secret.yaml.example secret.yaml
# Or create via kubectl:
#   kubectl -n lip-registry create secret generic lip-registry-secrets \
#     --from-literal=LI_REGISTRY_DEV_TOKEN=... \
#     --from-literal=LI_JWT_SECRET=... \
#     --from-literal=GITLAB_TOKEN=...
#     --from-literal=GH_TOKEN=...
apiVersion: v1
kind: Secret
metadata:
  name: lip-registry-secrets
  namespace: lip-registry
type: Opaque
stringData:
  LI_REGISTRY_DEV_TOKEN: replace-me-before-apply
  LI_JWT_SECRET: replace-me-with-32-byte-secret
  GITLAB_TOKEN: ""
  GH_TOKEN: ""
