#!/usr/bin/env bash
# lis — Li data-platform supervisor (PH-DB-3/4 stub).
# Single entrypoint: HTTP gateway (future) + bundled lidb stack (registry-min profile).
set -euo pipefail

LIS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export LIS_ROOT

lis_usage() {
  cat <<'EOF'
lis — Li supervisor (data platform + HTTP gateway)

Usage:
  lis db start [--profile NAME] [--foreground]
  lis db stop
  lis db status
  lis db migrate [--to REV]
  lis http validate <config.toml>
  lis http flatten <config.toml> [-o PATH]
  lis http render-caddy <config.toml> [-o PATH]
  lis http apply-lip [--http-only|--tls]   # liserver edge (li-httpd) for lip.lilangverse.xyz
  lis staging up [--with-supabase]
  lis staging down

Environment (db subcommands):
  LI_DATA_DIR   Data directory (default: ~/.local/share/lis/data)
  LI_PROFILE    Bundle profile (default: registry-min)
  LI_API_PORT   REST/PostgREST-shaped API (default: 54321)
  LI_DB_PORT    Postgres wire / lidb (default: 54322)
  LI_REGISTRY_API  Start registry REST on db start (default: 1; set 0 to skip)
  LI_REALTIME_PORT WebSocket Realtime (default: 54323; stack-full profile)
  LI_REALTIME_API  Start Realtime WS on db start (default: 1 for stack-full)

PH-DB-3/4: CLI + registry REST + Realtime WS; lidb native embed via lidb_embed (no loopback TCP for registry-min).
EOF
}


lis_lidb_root() {
  if [[ -n "${LIDB_ROOT:-}" && -d "${LIDB_ROOT}" ]]; then
    echo "${LIDB_ROOT}"
    return 0
  fi
  if [[ -d "${LIS_ROOT}/../lidb" ]]; then
    echo "${LIS_ROOT}/../lidb"
    return 0
  fi
  echo ""
}

lis_db_engine_ensure() {
  local data_dir="$1"
  local root
  root="$(lis_lidb_root)"
  if [[ -z "$root" ]]; then
    echo "lis db: lidb checkout not found (set LIDB_ROOT)" >&2
    return 1
  fi
  export LIDB_ROOT="$root"
  export LIDB_DATA_DIR="$data_dir"
  export LI_DATA_DIR="$data_dir"
  export PYTHONPATH="${root}${PYTHONPATH:+:$PYTHONPATH}"
  if ! python3 "${LIS_ROOT}/scripts/lidb_engine.py" ensure "$data_dir" >/dev/null; then
    echo "lis db: native lidb embed failed (build lidb_embed in ${root})" >&2
    return 1
  fi
  echo "native" >"${data_dir}/.lis-db-engine-ready"
  return 0
}

lis_db_start() {
  local profile="${LI_PROFILE:-registry-min}"
  local data_dir="${LI_DATA_DIR:-${HOME}/.local/share/lis/data}"
  local api_port="${LI_API_PORT:-54321}"
  local db_port="${LI_DB_PORT:-54322}"
  local realtime_port="${LI_REALTIME_PORT:-54323}"
  local foreground="${1:-}"

  mkdir -p "$data_dir"
  local pid_file="${data_dir}/lis-db.pid"
  if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    echo "lis db: already running (pid $(cat "$pid_file"), profile=${profile})" >&2
    exit 0
  fi

  echo "lis db start: profile=${profile} data_dir=${data_dir} api=${api_port} db=${db_port}"
  echo "  verticals: see profiles/${profile}.toml"
  if ! lis_db_engine_ensure "$data_dir"; then
    exit 1
  fi
  export PYTHONPATH="${LIS_ROOT}${PYTHONPATH:+:$PYTHONPATH}"
  python3 -c "from routes.registry.plans import ensure_registry_plans; ensure_registry_plans()" 2>/dev/null || true
  echo "profile=${profile}" >"${data_dir}/.lis-db-profile"
  echo "api_port=${api_port}" >"${data_dir}/.lis-db-ports"
  echo "db_port=${db_port}" >>"${data_dir}/.lis-db-ports"
  echo "realtime_port=${realtime_port}" >>"${data_dir}/.lis-db-ports"
  if [[ "$foreground" == "--foreground" ]]; then
    echo "lis db: foreground — Ctrl+C to stop"
    trap 'rm -f "'"${pid_file}"'" "'"${data_dir}/.lis-db-engine-ready"'"' EXIT
    echo $$ >"$pid_file"
    while true; do sleep 3600; done
  else
    (
      echo $$
      while true; do sleep 3600; done
    ) &
    echo $! >"$pid_file"
    echo "lis db: supervisor pid $(cat "$pid_file") (lidb native embed)"
  fi
  if [[ "${LI_REGISTRY_API:-1}" != "0" ]]; then
    lis_registry_api_start "$api_port" "$data_dir"
  fi
  if lis_profile_wants_realtime "$profile"; then
    lis_realtime_start "$realtime_port" "$data_dir"
  fi
}

lis_profile_wants_realtime() {
  local profile="$1"
  if [[ "${LI_REALTIME_API:-}" == "1" ]]; then
    return 0
  fi
  [[ "$profile" == "stack-full" ]]
}

lis_registry_api_start() {
  local api_port="$1"
  local data_dir="$2"
  local reg_pid="${data_dir}/lis-registry-api.pid"
  if [[ -f "$reg_pid" ]] && kill -0 "$(cat "$reg_pid")" 2>/dev/null; then
    return 0
  fi
  export LI_DATA_DIR="$data_dir"
  export LI_API_PORT="$api_port"
  export LI_REGISTRY_QUIET=1
  export PYTHONPATH="${LIS_ROOT}${PYTHONPATH:+:$PYTHONPATH}"
  python3 "${LIS_ROOT}/routes/registry/server.py" --port "$api_port" &
  echo $! >"$reg_pid"
  echo "lis registry API (stub): http://127.0.0.1:${api_port}/v1 (pid $(cat "$reg_pid"))"
}

lis_realtime_start() {
  local rt_port="$1"
  local data_dir="$2"
  local rt_pid="${data_dir}/lis-realtime.pid"
  if [[ -f "$rt_pid" ]] && kill -0 "$(cat "$rt_pid")" 2>/dev/null; then
    return 0
  fi
  local py="python3"
  if [[ -x "${LIS_ROOT}/.venv-realtime/bin/python" ]]; then
    py="${LIS_ROOT}/.venv-realtime/bin/python"
  elif ! python3 -c "import websockets" 2>/dev/null; then
    if [[ -x "${LIS_ROOT}/scripts/ensure-realtime-venv.sh" ]]; then
      # shellcheck source=/dev/null
      source "${LIS_ROOT}/scripts/ensure-realtime-venv.sh" && py="${LIS_ROOT}/.venv-realtime/bin/python"
    fi
  fi
  if ! "$py" -c "import websockets" 2>/dev/null; then
    echo "lis realtime: skipped (run scripts/ensure-realtime-venv.sh)" >&2
    return 0
  fi
  export LI_DATA_DIR="$data_dir"
  export LI_REALTIME_PORT="$rt_port"
  export LI_REALTIME_QUIET=1
  export PYTHONPATH="${LIS_ROOT}${PYTHONPATH:+:$PYTHONPATH}"
  "$py" "${LIS_ROOT}/routes/realtime/server.py" --port "$rt_port" &
  echo $! >"$rt_pid"
  echo "lis realtime WS (stub): ws://127.0.0.1:${rt_port}/realtime/v1/websocket (pid $(cat "$rt_pid"))"
}

lis_db_stop() {
  local data_dir="${LI_DATA_DIR:-${HOME}/.local/share/lis/data}"
  local pid_file="${data_dir}/lis-db.pid"
  if [[ ! -f "$pid_file" ]]; then
    echo "lis db: not running (no pid file)"
    exit 0
  fi
  local pid
  pid="$(cat "$pid_file")"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    echo "lis db: stopped pid ${pid}"
  else
    echo "lis db: stale pid file removed"
  fi
  local reg_pid="${data_dir}/lis-registry-api.pid"
  if [[ -f "$reg_pid" ]] && kill -0 "$(cat "$reg_pid")" 2>/dev/null; then
    kill "$(cat "$reg_pid")" 2>/dev/null || true
    echo "lis registry API: stopped pid $(cat "$reg_pid")"
  fi
  local rt_pid="${data_dir}/lis-realtime.pid"
  if [[ -f "$rt_pid" ]] && kill -0 "$(cat "$rt_pid")" 2>/dev/null; then
    kill "$(cat "$rt_pid")" 2>/dev/null || true
    echo "lis realtime WS: stopped pid $(cat "$rt_pid")"
  fi
  rm -f "$pid_file" "$reg_pid" "$rt_pid" "${data_dir}/.lis-db-engine-ready" "${data_dir}/.lis-db-profile" "${data_dir}/.lis-db-ports"
}

lis_db_status() {
  local profile="${LI_PROFILE:-registry-min}"
  local data_dir="${LI_DATA_DIR:-${HOME}/.local/share/lis/data}"
  local api_port="${LI_API_PORT:-54321}"
  local db_port="${LI_DB_PORT:-54322}"
  local realtime_port="${LI_REALTIME_PORT:-54323}"
  local pid_file="${data_dir}/lis-db.pid"

  echo "profile:     ${profile}"
  echo "data_dir:    ${data_dir}"
  echo "api_port:    ${api_port}"
  echo "db_port:     ${db_port}"
  echo "realtime_port: ${realtime_port}"
  if [[ -f "${data_dir}/.lis-db-engine-ready" ]]; then
    echo "lidb_link:   native (in-process embed via lidb_embed)"
  else
    echo "lidb_link:   unavailable"
  fi
  local reg_pid="${data_dir}/lis-registry-api.pid"
  if [[ -f "$reg_pid" ]] && kill -0 "$(cat "$reg_pid")" 2>/dev/null; then
    echo "registry_api: running (pid $(cat "$reg_pid"), http://127.0.0.1:${api_port}/v1)"
  else
    echo "registry_api: stopped"
  fi
  local rt_pid="${data_dir}/lis-realtime.pid"
  if [[ -f "$rt_pid" ]] && kill -0 "$(cat "$rt_pid")" 2>/dev/null; then
    echo "realtime_ws: running (pid $(cat "$rt_pid"), ws://127.0.0.1:${realtime_port}/realtime/v1/websocket)"
  else
    echo "realtime_ws: stopped"
  fi
  if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    echo "state:       running (pid $(cat "$pid_file"), lidb supervisor)"
  else
    echo "state:       stopped"
  fi
}

lis_db_migrate() {
  local profile="${LI_PROFILE:-registry-min}"
  local data_dir="${LI_DATA_DIR:-${HOME}/.local/share/lis/data}"
  local to_rev="${1:-head}"
  echo "lis db migrate: profile=${profile} to=${to_rev}"
  mkdir -p "$data_dir"
  if ! lis_db_engine_ensure "$data_dir"; then
    exit 1
  fi
  echo "${to_rev}" >"${data_dir}/.lis-db-migrate-rev"
  echo "lis db migrate: applied native bootstrap to ${to_rev}"
}

lis_http_validate() {
  local cfg="$1"
  export PYTHONPATH="${LIS_ROOT}/scripts${PYTHONPATH:+:$PYTHONPATH}"
  python3 "${LIS_ROOT}/scripts/httpd_config.py" "$cfg"
}

lis_http_render_caddy() {
  local cfg="$1"
  shift
  local out=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output) out="$2"; shift 2 ;;
      *) echo "lis http render-caddy: unknown $1" >&2; exit 1 ;;
    esac
  done
  export PYTHONPATH="${LIS_ROOT}/scripts${PYTHONPATH:+:$PYTHONPATH}"
  if [[ -n "$out" ]]; then
    python3 "${LIS_ROOT}/scripts/httpd_render_caddy.py" "$cfg" -o "$out"
  else
    python3 "${LIS_ROOT}/scripts/httpd_render_caddy.py" "$cfg"
  fi
}

lis_http_flatten() {
  local cfg="$1"
  shift
  local out=""
  local flatten=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output) out="$2"; shift 2 ;;
      *) echo "lis http flatten: unknown $1" >&2; exit 1 ;;
    esac
  done
  flatten="${LI_HTTPD_ROOT:-${LIS_ROOT}/../li-httpd}/scripts/flatten-httpd-config.py"
  [[ -f "$flatten" ]] || { echo "lis http flatten: missing $flatten (set LI_HTTPD_ROOT)" >&2; exit 1; }
  [[ -n "$out" ]] || { echo "lis http flatten: -o PATH required" >&2; exit 1; }
  lis_http_validate "$cfg"
  export PYTHONPATH="$(dirname "$flatten"):${LIS_ROOT}/scripts${PYTHONPATH:+:$PYTHONPATH}"
  python3 "$flatten" "$cfg" -o "$out"
}

lis_http_apply_lip() {
  exec "${LIS_ROOT}/scripts/lip-liserver-apply.sh" "$@"
}

lis_staging_up() {
  echo "lis staging: application stacks live in your app repo (e.g. cap-jmk-launchpad/majico.xyz deploy/staging)." >&2
  echo "See https://github.com/cap-jmk-launchpad/majico.xyz/tree/main/deploy/staging" >&2
  exit 1
}

lis_staging_down() {
  echo "lis staging down: use podman compose in your application deploy/staging directory." >&2
  exit 1
}

main() {
  if [[ $# -lt 1 ]]; then
    lis_usage
    exit 1
  fi
  case "$1" in
    http)
      shift
      [[ $# -ge 1 ]] || { lis_usage; exit 1; }
      case "$1" in
        validate)
          shift
          [[ $# -ge 1 ]] || { echo "lis http validate: config.toml required" >&2; exit 1; }
          lis_http_validate "$1"
          ;;
        render-caddy)
          shift
          [[ $# -ge 1 ]] || { echo "lis http render-caddy: config.toml required" >&2; exit 1; }
          local cfg="$1"
          shift
          lis_http_render_caddy "$cfg" "$@"
          ;;
        flatten)
          shift
          [[ $# -ge 1 ]] || { echo "lis http flatten: config.toml required" >&2; exit 1; }
          local cfg="$1"
          shift
          lis_http_flatten "$cfg" "$@"
          ;;
        apply-lip)
          shift
          lis_http_apply_lip "$@"
          ;;
        *) echo "lis http: unknown subcommand: $1" >&2; lis_usage; exit 1 ;;
      esac
      ;;
    staging)
      shift
      [[ $# -ge 1 ]] || { lis_usage; exit 1; }
      case "$1" in
        up) shift; lis_staging_up "$@" ;;
        down) lis_staging_down ;;
        *) echo "lis staging: unknown subcommand: $1" >&2; lis_usage; exit 1 ;;
      esac
      ;;
    db)
      shift
      [[ $# -ge 1 ]] || { lis_usage; exit 1; }
      case "$1" in
        start)
          shift
          local fg=""
          [[ "${1:-}" == "--foreground" ]] && { fg="--foreground"; shift; }
          [[ "${1:-}" == "--profile" ]] && { export LI_PROFILE="$2"; shift 2; }
          lis_db_start "$fg"
          ;;
        stop) lis_db_stop ;;
        status) lis_db_status ;;
        migrate)
          shift
          local to="head"
          [[ "${1:-}" == "--to" ]] && { to="$2"; shift 2; }
          lis_db_migrate "$to"
          ;;
        -h|--help|help) lis_usage ;;
        *) echo "lis db: unknown subcommand: $1" >&2; lis_usage; exit 1 ;;
      esac
      ;;
    -h|--help|help) lis_usage ;;
    *) echo "lis: unknown command: $1" >&2; lis_usage; exit 1 ;;
  esac
}

main "$@"
