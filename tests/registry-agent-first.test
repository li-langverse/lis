#!/usr/bin/env bash
# Agent-first registry API smoke (capabilities + validate + remediation).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

export LI_REGISTRY_MOCK=1
export LI_REGISTRY_QUIET=1
export PYTHONPATH="$ROOT"

DATA_DIR="${TMPDIR:-/tmp}/lis-agent-first-test-$$"
export LI_DATA_DIR="$DATA_DIR"
LI_API_PORT="$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')"
export LI_API_PORT

cleanup() {
  if [[ -n "${SERVER_PID:-}" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  rm -rf "$DATA_DIR"
}
trap cleanup EXIT

python3 routes/registry/server.py --port "$LI_API_PORT" &
SERVER_PID=$!
for _ in $(seq 1 40); do
  curl -sf "http://127.0.0.1:${LI_API_PORT}/health" >/dev/null 2>&1 && break
  sleep 0.1
done

BASE="http://127.0.0.1:${LI_API_PORT}"

caps="$(curl -sf "${BASE}/v1/agent/capabilities")"
echo "$caps" | grep -q '"auth_modes"'
echo "$caps" | grep -q '"max_blob_bytes"'

validate="$(curl -sf -X POST "${BASE}/v1/publish/validate" \
  -H 'Content-Type: application/json' \
  -d '{"name":"pkg-ok","version":"0.1.0","tree_digest":"sha256:'$(printf 'a%.0s' {1..64})'","proof_digest":"sha256:'$(printf 'b%.0s' {1..64})'","coverage_pct":85.0}')"
echo "$validate" | grep -q '"ok"'
echo "$validate" | grep -q '"remediation"'

bad="$(curl -sf -X POST "${BASE}/v1/publish/validate" \
  -H 'Content-Type: application/json' \
  -d '{"name":"pkg-ok","version":"0.1.0","coverage_pct":50.0}')"
echo "$bad" | grep -q '"ok": false'
echo "$bad" | grep -q '"remediation"'

code=$(curl -s -o /tmp/lip-unauth-$$.json -w '%{http_code}' -X POST "${BASE}/v1/packages/demo/versions" \
  -H 'Content-Type: application/json' \
  -d '{"version":"9.9.9","tree_digest":"sha256:'$(printf 'c%.0s' {1..64})'","proof_digest":"sha256:'$(printf 'd%.0s' {1..64})'","coverage_pct":90}')
test "$code" = "401"
grep -q '"remediation"' /tmp/lip-unauth-$$.json
rm -f /tmp/lip-unauth-$$.json

echo "registry-agent-first: OK"
