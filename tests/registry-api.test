#!/usr/bin/env bash
# Integration: registry REST + lidb liorm (default) or mock (LI_REGISTRY_MOCK=1).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

export LI_REGISTRY_QUIET=1
export LI_REGISTRY_DEV_TOKEN="${LI_REGISTRY_DEV_TOKEN:-test-token}"

LIDB_ROOT="${LIDB_ROOT:-$ROOT/../lidb}"
HAS_LIORM=0
if [[ -f "$LIDB_ROOT/liorm/execute.py" ]]; then
  HAS_LIORM=1
  export LIDB_ROOT
fi

run_registry_smoke() {
  local mode_label="$1"
  local expect_backend="$2"

  local data_dir="${TMPDIR:-/tmp}/lis-registry-api-$$-${mode_label}"
  export LI_DATA_DIR="$data_dir"
  export LI_API_PORT
  LI_API_PORT="$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')"
  export PYTHONPATH="$ROOT"
  if [[ "$HAS_LIORM" == 1 ]]; then
    export PYTHONPATH="$LIDB_ROOT:$ROOT"
  fi

  local SERVER_PID=""
  cleanup() {
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
      kill "$SERVER_PID" 2>/dev/null || true
      wait "$SERVER_PID" 2>/dev/null || true
    fi
    rm -rf "$data_dir"
  }
  trap cleanup RETURN

  python3 routes/registry/server.py --port "$LI_API_PORT" &
  SERVER_PID=$!
  for _ in $(seq 1 30); do
    if curl -sf "http://127.0.0.1:${LI_API_PORT}/health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done

  BASE="http://127.0.0.1:${LI_API_PORT}"

  curl -sf "${BASE}/health" | grep -q '"status"'
  curl -sf "${BASE}/health" | grep -qE "\"backend\"[[:space:]]*:[[:space:]]*\"${expect_backend}\""
  curl -sf "${BASE}/v1/openapi.yaml" | grep -q 'openapi: 3.0.3'
  curl -sf "${BASE}/v1/packages" | grep -q '"packages"'
  curl -sf "${BASE}/v1/packages/pkg-ok/0.1.0" | grep -q 'pkg-ok'

  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "${BASE}/v1/packages/demo-pkg/versions" \
    -H 'Content-Type: application/json' \
    -d '{"version":"1.0.0","tree_digest":"sha256:'$(printf 'c%.0s' {1..64})'","proof_digest":"sha256:'$(printf 'd%.0s' {1..64})'","coverage_pct":90}')
  test "$code" = "401"

  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "${BASE}/v1/packages/demo-pkg/versions" \
    -H 'Authorization: Bearer test-token' \
    -H 'Content-Type: application/json' \
    -d '{"version":"1.0.0","tree_digest":"sha256:'$(printf 'c%.0s' {1..64})'","proof_digest":"sha256:'$(printf 'd%.0s' {1..64})'","coverage_pct":90}')
  test "$code" = "201"

  curl -sf "${BASE}/v1/packages?name=demo-pkg" | grep -q '1.0.0'

  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "${BASE}/v1/packages/demo-pkg/1.0.0/yank" \
    -H 'Authorization: Bearer test-token' \
    -H 'Content-Type: application/json' \
    -d '{"reason":"integration test yank"}')
  test "$code" = "200"

  curl -sf "${BASE}/v1/packages?name=demo-pkg" | grep -qv '1.0.0'

  code=$(curl -s -o /dev/null -w '%{http_code}' "${BASE}/v1/packages/demo-pkg/1.0.0")
  test "$code" = "410"

  echo "registry-api (${mode_label}): OK"
}

if [[ "$HAS_LIORM" == 1 ]]; then
  unset LI_REGISTRY_MOCK
  run_registry_smoke liorm liorm
else
  echo "registry-api: skip liorm path (no ${LIDB_ROOT}/liorm/execute.py)" >&2
fi

export LI_REGISTRY_MOCK=1
run_registry_smoke mock mock

echo "registry-api integration: all modes OK"
